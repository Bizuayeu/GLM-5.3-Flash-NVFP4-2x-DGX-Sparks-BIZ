ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY glm53_setup /opt/glm53/glm53_setup
COPY config /opt/glm53/config
COPY examples/startup.example.toml /opt/glm53/examples/startup.example.toml
COPY pyproject.toml /opt/glm53/pyproject.toml
COPY LICENSE NOTICE /opt/glm53/
COPY LICENSES /opt/glm53/LICENSES
ENV PYTHONPATH=/opt/glm53
RUN python3 -m glm53_setup patch-reference
ENV GLM53_REFERENCE_ATTENTION=1
LABEL glm53.setup.model="glm53-nvidia" glm53.setup.attention="full-candidate-reference"
