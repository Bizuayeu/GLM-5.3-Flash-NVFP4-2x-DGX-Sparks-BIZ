ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY glm53_setup /opt/glm53/glm53_setup
COPY config /opt/glm53/config
COPY examples/server.example.toml /opt/glm53/examples/server.example.toml
COPY pyproject.toml /opt/glm53/pyproject.toml
COPY LICENSE NOTICE /opt/glm53/
COPY LICENSES /opt/glm53/LICENSES
ENV PYTHONPATH=/opt/glm53
RUN python3 -m glm53_setup patch-reference
RUN python3 -m glm53_setup.runtime.patch_pipeline
RUN python3 -m glm53_setup.runtime.patch_apc_lpa
RUN python3 -m glm53_setup.runtime.patch_moe_order
RUN python3 -m glm53_setup.runtime.patch_indexer_topk
RUN python3 -m glm53_setup.runtime.patch_slot_mapping
RUN python3 -m glm53_setup.runtime.patch_adaptive_depth
ENV GLM53_APC_LPA_API=1
ENV GLM53_PIPELINE_API=1
ENV GLM53_REFERENCE_ATTENTION=1
ENV GLM53_CANONICAL_CANDIDATES=1
ENV GLM53_MOE_ORDER_API=2
ENV GLM53_CANONICAL_MOE_ORDER=1
ENV GLM53_INDEXER_TOPK_API=1
ENV GLM53_SLOT_MAPPING_GUARD=1
ENV GLM53_ADAPTIVE_DEPTH_API=1
ENV GLM53_FA2_ATTENTION_API=1
ENV GLM53_STABLE_INDEXER_TOPK=1
ENV GLM53_LPA_API=2
ENV GLM53_FUSED_UNPACK_SUPPORTED=1
ENV GLM53_COMPONENT_API=1
ENV GLM53_DECODE_GRAPH_API=1
ENV GLM53_ASYNC_INDEX_CHECK_API=1
ENV GLM53_EXPERT_PARALLEL_API=1
LABEL glm53.setup.model="glm53-nvidia" glm53.setup.attention="full-candidate-reference"
